# Beachrex MCP Server Environment
# The server does not load this file itself: export the variables in your shell,
# or use ecosystem.config.cjs (pm2), which sets them per MCP_ENV (dev|uat|prod).

# Environment for ecosystem.config.cjs: dev (default) | uat | prod
MCP_ENV=dev

# API URL (dev: https://dev-api.beachrex.com, uat: https://uat-api.beachrex.com, prod: https://api.beachrex.com)
BEACHREX_API_URL=https://dev-api.beachrex.com

# API key (stored server-side, never exposed to AI)
# Leave empty for public endpoints that don't require auth
BEACHREX_API_KEY=

# API request timeout in milliseconds (default 15000)
BEACHREX_API_TIMEOUT_MS=15000

# CDN base URLs for beach images (DigitalOcean Spaces + Imagor)
BEACHREX_CDN_URL=https://s3.beachrex.com/unsafe/fit-in/800x800/
BEACHREX_CDN_THUMB=https://s3.beachrex.com/unsafe/fit-in/200x200/

# Frontend URL for "View on Beachrex" links (dev: https://dev.beachrex.com, uat: https://uat.beachrex.com, prod: https://beachrex.com)
BEACHREX_FRONTEND_URL=https://dev.beachrex.com

# Transport mode:
# - Set MCP_HTTP_PORT to enable HTTP transport (for cloud AI: Claude.ai, ChatGPT). dev 3100, uat 3101, prod 3102
# - Leave empty for stdio transport (local dev: Cursor, Claude Desktop)
MCP_HTTP_PORT=3100

# Direct Spaces URL used for image paths with non-ASCII characters (Imagor bypass)
BEACHREX_CDN_ASSETS=https://beachrex.fra1.digitaloceanspaces.com/public/
