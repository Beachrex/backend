# Beachrex MCP Server Environment

# API URL (use dev for development, prod for production)
BEACHREX_API_URL=https://dev-api.beachrex.com

# API key (stored server-side, never exposed to AI)
# Leave empty for public endpoints that don't require auth
BEACHREX_API_KEY=

# Server port (for HTTP transport mode, not used in stdio)
# MCP_PORT=3000
