                                                    },
                                                    "full_name": {
                                                        "type": "string",
                                                        "example": "Republic of Slovenia"
                                                    },
                                                    "iso3": {
                                                        "type": "string",
                                                        "example": "SVN"
                                                    },
                                                    "continent_code": {
                                                        "type": "string",
                                                        "example": "EU"
                                                    },
                                                    "beaches_count": {
                                                        "type": "integer",
                                                        "example": 5
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Countries retrieved successfully"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "An error occurred"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
