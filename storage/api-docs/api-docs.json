    "components": {
        "schemas": {
            "BeachSchema": {
                "title": "Beach Schema",
                "description": "Beach API Resource",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "user_id": {
                        "type": "integer",
                        "example": 5
                    },
                    "status": {
                        "type": "string",
                        "example": "Active"
                    },
                    "name": {
                        "type": "string",
                        "example": "Plaža Dječji raj"
                    },
                    "description": {
                        "type": "string",
                        "example": "Family-friendly beach"
                    },
                    "latitude": {
                        "type": "number",
                        "format": "float",
                        "example": 45.1234567
                    },
                    "longitude": {
                        "type": "number",
                        "format": "float",
                        "example": 14.9876543
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Continent": {
                "title": "Continent",
                "description": "Continent model",
                "properties": {
                    "code": {
                        "description": "Two-letter continent code",
                        "type": "string",
                        "maxLength": 2,
                        "example": "EU"
                    },
                    "name": {
                        "description": "Continent name",
                        "type": "string",
                        "example": "Europe"
                    },
                    "beaches_count": {
                        "description": "Number of beaches in this continent",
                        "type": "integer",
                        "example": 15
                    }
                },
                "type": "object"
            },
            "Country": {
                "title": "Country",
                "description": "Country model",
                "properties": {
                    "code": {
                        "description": "Two-letter country code (ISO 3166-1 alpha-2)",
                        "type": "string",
                        "maxLength": 2,
                        "example": "SI"
                    },
                    "name": {
                        "description": "Country name",
                        "type": "string",
                        "maxLength": 100,
                        "example": "Slovenia"
                    },
                    "full_name": {
                        "description": "Full official country name",
                        "type": "string",
                        "maxLength": 255,
                        "example": "Republic of Slovenia"
                    },
                    "iso3": {
                        "description": "Three-letter country code (ISO 3166-1 alpha-3)",
                        "type": "string",
                        "maxLength": 3,
                        "example": "SVN"
                    },
                    "continent_code": {
                        "description": "Two-letter continent code",
                        "type": "string",
                        "maxLength": 2,
                        "example": "EU"
                    },
                    "beaches_count": {
                        "description": "Number of beaches in this country",
                        "type": "integer",
                        "example": 5
                    },
                    "continent": {
                        "$ref": "#/components/schemas/Continent"
                    }
                },
                "type": "object"
            },
            "LoginRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "john@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "secret123"
                    }
                },
                "type": "object"
            },
            "LoginResponse": {
                "properties": {
                    "token": {
                        "type": "string",
                        "example": "2|KJDF82kdjkfj..."
                    },
                    "user": {
                        "$ref": "#/components/schemas/User"
                    }
                },
                "type": "object"
            },
            "RegisterResponse": {
                "properties": {
                    "user": {
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 1
                            },
                            "name": {
                                "type": "string",
                                "example": "John Doe"
                            },
                            "email": {
                                "type": "string",
                                "example": "john@example.com"
                            }
                        },
                        "type": "object"
                    },
                    "token": {
                        "type": "string",
                        "example": "abc123token"
                    }
                },
                "type": "object"
            },
            "ValidationError": {
                "title": "Validation Error",
                "description": "Validation error response",
                "properties": {
                    "message": {
                        "description": "Error message",
                        "type": "string",
                        "example": "The given data was invalid."
                    },
                    "errors": {
                        "description": "Field-specific validation errors",
                        "properties": {
                            "latitude": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "example": "The latitude field is required."
                                }
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "TokenResponse": {
                "title": "Token Response",
                "properties": {
                    "token": {
                        "type": "string",
                        "example": "abc123"
                    },
                    "user": {
                        "$ref": "#/components/schemas/User"
                    }
                },
                "type": "object"
            },
            "User": {
                "title": "User",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
