{
    "openapi": "3.0.0",
    "info": {
        "title": "Beachrex API",
        "description": "\nThis is the API documentation for the Beachrex backend. Some of the endpoints use token-based authentication via Laravel Sanctum.\n\n **Authentication**\n\nAll protected endpoints require an `Authorization` header:\n\nAuthorization: Bearer YOUR_API_TOKEN\n\nYou can get your token via the `/api/v1/login` endpoint.\n",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Beachrex API Server"
        },
        {
            "url": "https://dev-api.beachrex.com",
            "description": "Development Server"
        },
        {
            "url": "https://stage-api.beachrex.com",
            "description": "Staging Server"
        },
        {
            "url": "https://api.beachrex.com",
            "description": "Production Server"
        }
    ],
    "paths": {
        "/api/v1/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register a new user",
                "operationId": "ad77fe138bcb384ad65d167d5c8d1cc0",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Successful registration",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RegisterResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/v1/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login user and get API token",
                "operationId": "bae68d1c55329ecb6e41f48285840c8f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
        "/api/v1/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Logout the currently authenticated user",
                "description": "**This endpoint requires an Authorization header with a Bearer token.** Example: `Authorization: Bearer YOUR_TOKEN`",
                "operationId": "c5cdd87fdbf9d0f95dede875bd023dec",
                "responses": {
                    "200": {
                        "description": "Successful logout",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Logged out"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/beaches": {
            "get": {
                "tags": [
                    "Beaches"
                ],
                "summary": "List all beaches",
                "operationId": "336af36be8591e410bac9522c3924823",
                "responses": {
                    "200": {
                        "description": "List of beaches",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/BeachSchema"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Beaches"
                ],
                "summary": "Create a new beach",
                "operationId": "09ec9981daa4e9f7d7fca7cd6ceee764",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "latitude",
                                    "longitude",
                                    "translations"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Fallback beach name"
                                    },
                                    "latitude": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 45.1234567
                                    },
                                    "longitude": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 13.9876543
                                    },
                                    "translations": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "locale": {
                                                    "type": "string",
                                                    "example": "en"
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "Children's Paradise Beach"
                                                },
                                                "description": {
                                                    "type": "string",
                                                    "example": "A beach perfect for families."
                                                },
                                                "slug": {
                                                    "type": "string",
                                                    "example": "childrens-paradise-beach"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Beach created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BeachSchema"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/v1/beaches/{id}": {
            "get": {
                "tags": [
                    "Beaches"
                ],
                "summary": "Get a single beach by ID",
                "operationId": "29ba39bdeef7e605f8fce75b48a4d74a",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Beach ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Beach found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BeachSchema"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            }
        },
        "/api/v1/continents": {
            "get": {
                "tags": [
                    "Continents"
                ],
                "summary": "Get all continents that have beaches",
                "description": "Returns a list of continents that have at least one beach",
                "operationId": "getContinents",
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "code": {
                                                        "type": "string",
                                                        "example": "EU"
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Europe"
                                                    },
                                                    "beaches_count": {
                                                        "type": "integer",
                                                        "example": 15
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Continents retrieved successfully"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "An error occurred"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/continents/{code}": {
            "get": {
                "tags": [
                    "Continents"
                ],
                "summary": "Get a specific continent",
                "description": "Returns a specific continent by code with its beaches count",
                "operationId": "getContinent",
                "parameters": [
                    {
                        "name": "code",
                        "in": "path",
                        "description": "Continent code (e.g., EU, AS, NA)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "EU"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "code": {
                                                    "type": "string",
                                                    "example": "EU"
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "Europe"
                                                },
                                                "beaches_count": {
                                                    "type": "integer",
                                                    "example": 15
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Continent retrieved successfully"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Continent not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Continent not found"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/countries": {
            "get": {
                "tags": [
                    "Countries"
                ],
                "summary": "Get all countries that have beaches",
                "description": "Returns a list of countries that have at least one beach. Can be filtered by continent.",
                "operationId": "getCountries",
                "parameters": [
                    {
                        "name": "continent",
                        "in": "query",
                        "description": "Filter by continent code (e.g., EU, AS, NA)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "EU"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
