# BeachRex API — Production Dockerfile (PHP 8.4 FPM)
# Based on Debian bookworm (more reliable for imagick/pecl than Alpine).
# Used by deploy/docker-compose.vps.yml for api_prod / api_stage / api_dev.

FROM php:8.4-fpm-bookworm

LABEL maintainer="BeachRex Ops"

# System deps + PHP extension build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash git unzip curl \
        libpq-dev postgresql-client \
        libzip-dev zlib1g-dev \
        libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
        libicu-dev \
        libonig-dev \
        libmagickwand-dev \
        libssl-dev \
        supervisor \
        nginx \
    && rm -rf /var/lib/apt/lists/* \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        pdo_pgsql pgsql \
        gd \
        zip \
        intl \
        bcmath \
        pcntl \
        opcache \
        soap \
    && pecl install redis igbinary \
    && docker-php-ext-enable redis igbinary opcache

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Production PHP config
RUN { \
        echo "memory_limit=512M"; \
        echo "upload_max_filesize=25M"; \
        echo "post_max_size=25M"; \
        echo "max_execution_time=120"; \
        echo "opcache.enable=1"; \
        echo "opcache.memory_consumption=128"; \
        echo "opcache.max_accelerated_files=20000"; \
        echo "opcache.validate_timestamps=0"; \
        echo "opcache.revalidate_freq=0"; \
    } > /usr/local/etc/php/conf.d/zz-beachrex-prod.ini

WORKDIR /var/www/html

# Copy app and install deps AT BUILD TIME (production-correct)
COPY --chown=www-data:www-data . .

# Remove stale bootstrap cache that references dev-only providers (e.g. Pail)
RUN rm -f bootstrap/cache/packages.php bootstrap/cache/services.php bootstrap/cache/compiled.php

# Install composer deps (no-dev: pail/collision/etc excluded → no missing providers)
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Permissions for Laravel storage
RUN mkdir -p storage/framework/{cache,sessions,views} storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

USER www-data

EXPOSE 9000
