APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Swagger API Documentation URL (will use APP_URL if not set)
L5_SWAGGER_CONST_HOST=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# For production with subdomains, use: SESSION_DOMAIN=.beachrex.com
SESSION_SAME_SITE=lax
SESSION_SECURE=false
# For production, use: SESSION_SECURE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=

# Sanctum Configuration
# For production with subdomains, add all domains that should have stateful authentication
# Example: SANCTUM_STATEFUL_DOMAINS=dock.beachrex.com,beachrex.com,www.beachrex.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000false

VITE_APP_NAME="${APP_NAME}"

# OpenAI API Configuration (for beach translation script)
OPENAI_API_KEY=

# DigitalOcean Spaces Configuration
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=beachrex
DO_SPACES_CDN_ENDPOINT=https://beachrex.fra1.digitaloceanspaces.com/public

# Imagor Image Processing Server Configuration
# Imagor provides fast, secure image resizing and transformation
# Documentation: https://github.com/cshum/imagor
IMAGOR_PORT=8001
IMAGOR_SECRET=changeme_generate_random_secret_key
IMAGOR_URL=http://imagor:8000
IMAGOR_PUBLIC_URL=http://localhost:8001

# Imagor Feature Flags
IMAGOR_UNSAFE=1                 # Set to 1 to enable unsigned URLs (for testing only, disable in production!)
IMAGOR_AUTO_WEBP=1              # Auto-convert to WebP if browser supports
IMAGOR_AUTO_AVIF=0              # Auto-convert to AVIF if browser supports (experimental)

# Imagor Cache Configuration
IMAGOR_CACHE_HEADER_TTL=168h    # Cache TTL (7 days)
IMAGOR_CACHE_HEADER_SWR=24h     # Stale-while-revalidate (1 day)
IMAGOR_RESULT_STORAGE_EXPIRATION=720h  # Result storage expiration (30 days)

# Imagor Image Limits (prevent image bombs)
IMAGOR_MAX_WIDTH=5000
IMAGOR_MAX_HEIGHT=5000
IMAGOR_MAX_RESOLUTION=16800000

# Imagor Logging
IMAGOR_ACCESS_LOG=0             # Set to 1 to enable access logs
