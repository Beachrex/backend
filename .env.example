APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Swagger API Documentation URL (will use APP_URL if not set)
L5_SWAGGER_CONST_HOST=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default for local dev (Sail). On the VPS use pgsql + PostGIS.
DB_CONNECTION=sqlite
# VPS / production PostgreSQL (PostGIS) — uncomment and set:
# DB_CONNECTION=pgsql
# DB_HOST=pgsql
# DB_PORT=5432
# DB_DATABASE=beachrex_prod    # or beachrex_uat / beachrex_dev
# DB_USERNAME=beachrex
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# For production with subdomains, use: SESSION_DOMAIN=.beachrex.com
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
# For production, use: SESSION_SECURE_COOKIE=true (config/session.php reads this name)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# On the VPS use Redis for cache/queue:
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis

CACHE_STORE=database
# CACHE_PREFIX=

# Redis (VPS): single container, logical DB per environment
# prod=0, uat=1, dev=2
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_DB=0    # set per environment on the VPS

# Scout Search Configuration
SCOUT_DRIVER=meilisearch
# Per-environment prefix on the VPS (separate Meilisearch indexes):
#   prod: prod_  |  uat: uat_  |  dev: dev_
SCOUT_PREFIX=
SCOUT_QUEUE=false

# Meilisearch Configuration
# Local dev (Docker Compose): http://meilisearch:7700
# VPS / production: https://search.beachrex.com (dedicated Hetzner server)
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey
MEILISEARCH_NO_ANALYTICS=true
MEILISEARCH_ENV=development
FORWARD_MEILISEARCH_PORT=7700

MEMCACHED_HOST=127.0.0.1

# Password reset e-mails (servers): MAIL_MAILER=smtp, MAIL_SCHEME=smtps, MAIL_HOST=mail.datavallis.com,
# MAIL_PORT=465, MAIL_USERNAME=hello@beachrex.com, MAIL_PASSWORD only in /opt/beachrex/envs (never in git),
# MAIL_FROM_ADDRESS=hello@beachrex.com, MAIL_FROM_NAME=Beachrex. FRONTEND_URL builds the reset link.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=

# Sanctum Configuration
# For production with subdomains, add all domains that should have stateful authentication
# Example: SANCTUM_STATEFUL_DOMAINS=dock.beachrex.com,beachrex.com,www.beachrex.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000false

VITE_APP_NAME="${APP_NAME}"

# OpenAI API Configuration (for beach translation script)
OPENAI_API_KEY=

# AI Agent Configuration
AI_ENABLED=true
AI_FREE_TIER_ENABLED=true
AI_STREAMING_ENABLED=false

# AI Provider Settings
AI_PROVIDER=openai
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# Website chat engine (AI-2): pipeline (default) or agent (the model calls the beach tools like the MCP server).
# Compare models first: php artisan ai:chat-eval --provider=openai|anthropic --model=...
AI_CHAT_ENGINE=pipeline
AI_CHAT_PROVIDER=openai
# AI_CHAT_OPENAI_MODEL=gpt-4o
# AI_CHAT_ANTHROPIC_MODEL=claude-opus-5-5
# AI_CHAT_EFFORT=low
# AI_CHAT_MAX_TOOL_ROUNDS=4
# Claude (official Anthropic PHP SDK); the key only in /opt/beachrex/envs/.env.<env>, never in git
# ANTHROPIC_API_KEY=

# AI chat conversations are deleted this many days after their last activity (daily ai:prune-conversations).
# Unset = 180 (owner 2026-10-29). 0 = the scheduled deletion does not run.
# AI_CHAT_RETENTION_DAYS=180

# AI daily cost limits (USD, owner 2026-10-29). Leave unset to use the code defaults: free chat 5, everything 20.
# The day is the local day in AI_DAILY_LIMIT_TIMEZONE (default Europe/Ljubljana); the chat is back at midnight.
# AI_FREE_TIER_DAILY_LIMIT=5
# AI_EMERGENCY_SHUTDOWN_LIMIT=20
# AI_DAILY_LIMIT_TIMEZONE=Europe/Ljubljana
# One e-mail per day when a limit trips (needs MAIL_*); empty = only a log line
AI_ALERT_EMAIL=

# Cloudflare Turnstile on the AI chat. Empty secret = check off. The site key goes into the web client's
# NEXT_PUBLIC_TURNSTILE_SITE_KEY (.env.front.<env>). Secret only in /opt/beachrex/envs/.env.<env>, never in git.
TURNSTILE_SECRET_KEY=
# web (default) = only browser requests are checked (the mobile app is not); all = every client
# TURNSTILE_REQUIRED_FOR=web

# DigitalOcean Spaces Configuration
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=beachrex
# CDN endpoint for API responses (frontend uses this with Imagor)
DO_SPACES_CDN_ENDPOINT=https://s3.beachrex.com
# Admin panel endpoint (direct DigitalOcean Spaces URL for uploads/display)
DO_SPACES_CDN_ENDPOINT_ADMIN=https://beachrex.fra1.digitaloceanspaces.com/public
OPENWEATHER_API_KEY=xxx
# Open-Meteo Marine API key (sea temperature). Empty = free endpoint, non-commercial use only.
OPEN_METEO_API_KEY=


# Add these to your .env:
# Scout Configuration
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=false
SCOUT_PREFIX=

# Meilisearch Configuration
MEILISEARCH_HOST=https://search.beachrex.com
MEILISEARCH_KEY=xxx

# AI Payments
AI_PAYMENTS_ENABLED=true

# Stripe Configuration
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Stripe Products (Test Mode Price IDs)
STRIPE_PRODUCT_ITINERARY_3DAY_PRICE_ID=price_YOUR_3DAY_PRICE_ID
STRIPE_PRODUCT_ITINERARY_7DAY_PRICE_ID=price_YOUR_7DAY_PRICE_ID
STRIPE_PRODUCT_ITINERARY_14DAY_PRICE_ID=price_YOUR_14DAY_PRICE_ID
# AI-4: version of the terms of sale buyers accept at checkout (stored on each Stripe session).
STRIPE_TERMS_VERSION=2026-10-09
# VAT by the buyer's country via Stripe Tax (turn on Stripe Tax and use prices with tax behaviour "inclusive").
STRIPE_TAX_ENABLED=false
# Stripe issues and e-mails an invoice for each payment (company details from the Stripe account; fee applies).
STRIPE_INVOICES_ENABLED=false

# Frontend URLs
FRONTEND_URL=http://localhost:3000

# Filament Admin Panel Domain (per environment on VPS)
#   prod: dock.beachrex.com
#   uat:  dock-uat.beachrex.com
#   dev:  dock-dev.beachrex.com
#   local: (leave empty)
FILAMENT_DOMAIN=

# Google OAuth Configuration (for production authentication)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_AUTH_ENABLED is not read by the code (Google sign-in works when GOOGLE_CLIENT_ID/SECRET are set)
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=678635083753-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_REDIRECT_URI=https://dev-api.beachrex.com/api/v1/auth/google/callback

# Database backups (php artisan db:backup, scheduled daily by the scheduler_<env> container).
# Must be a PRIVATE bucket (NOT the public "beachrex" media bucket). Values live only in
# /opt/beachrex/envs/.env.<env> on the VPS. See docs/runbooks/restore-backup.md.
BACKUP_ENABLED=false
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=fra1
BACKUP_S3_ENDPOINT=https://fra1.digitaloceanspaces.com
BACKUP_KEEP_DAYS=14
BACKUP_TIME=02:30

# PHP-FPM pool size (Dockerfile.prod defaults: dynamic, 16 children, 4 start, 2-8 spare, 1000 requests per child).
# Optional per environment; prod can raise PHP_FPM_MAX_CHILDREN (each worker uses ~50-100 MB RAM).
# PHP_FPM_MAX_CHILDREN=

# Mobile app (B-M1, GET /api/v1/app-config): versions per platform, store links, feature flags
MOBILE_IOS_MIN_VERSION=1.0.0
MOBILE_IOS_LATEST_VERSION=1.0.0
MOBILE_IOS_STORE_URL=
MOBILE_ANDROID_MIN_VERSION=1.0.0
MOBILE_ANDROID_LATEST_VERSION=1.0.0
MOBILE_ANDROID_STORE_URL=
MOBILE_FEATURE_AI_CHAT=false
MOBILE_FEATURE_ITINERARY=false
MOBILE_FEATURE_FAVORITES=false
MOBILE_FEATURE_NATIVE_SIGN_IN=false
FAVORITES_LIMIT=500

# Windy webcams (TASK-006). Key from https://api.windy.com/keys; used only by the webcams:* batch commands.
WINDY_API_KEY=
# Hard cap on Windy API requests per day for the batch commands
WINDY_DAILY_REQUEST_BUDGET=500
# Max distance (metres) between a place and a matched webcam (owner 2026-10-14: 3 km)
WEBCAMS_MAX_RADIUS_M=3000
# Daily scheduled webcams:refresh (re-imports every 30 days); enable after the first manual import
WEBCAMS_REFRESH_ENABLED=false
# Daily re-check (05:10) of the webcams shown on places in Windy's public player; no API key needed. Default true.
WEBCAMS_EMBED_RECHECK_ENABLED=true
# Who gets the e-mail when more than 10% of places lose their main webcam in a refresh
WEBCAMS_ALERT_EMAIL=

# Closed dev/uat website (ADR 2026-10-29 "Closed dev/uat websites behind an e-mail magic link"). true = the
# /api/v1/preview-access endpoints work (404 otherwise); never on production (FRONTEND_URL beachrex.com). Set the same
# name (+ PREVIEW_GATE_SECRET) in .env.front.<env> for the website.
PREVIEW_GATE_ENABLED=false
# Besides the admins of this environment, these addresses get a link (comma separated)
PREVIEW_ALLOWED_EMAILS=
