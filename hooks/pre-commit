#!/bin/bash

echo "Running tests before commit..."

# Run tests using Sail
./vendor/bin/sail artisan test

# Capture the exit code
TEST_EXIT_CODE=$?

# If tests failed, prevent the commit
if [ $TEST_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ Tests failed! Commit aborted."
    echo "Fix the failing tests before committing."
    echo ""
    echo "To skip this check (not recommended), use: git commit --no-verify"
    exit 1
fi

echo ""
echo "✅ All tests passed!"
echo ""
echo "Regenerating Swagger documentation..."

# Regenerate Swagger docs
./vendor/bin/sail artisan l5-swagger:generate

# Capture the exit code
SWAGGER_EXIT_CODE=$?

if [ $SWAGGER_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "⚠️  Warning: Swagger generation failed, but proceeding with commit."
else
    echo ""
    echo "✅ Swagger documentation regenerated successfully!"

    # Check if api-docs.json was modified
    if git diff --quiet storage/api-docs/api-docs.json; then
        echo "   No changes to Swagger documentation."
    else
        echo "   Swagger documentation updated. Adding to commit..."
        git add storage/api-docs/api-docs.json
        echo "   ✅ storage/api-docs/api-docs.json added to commit"
    fi
fi

echo ""
echo "✅ Proceeding with commit..."
exit 0

