<?php

namespace App\Http\Controllers\Api\V1;

use App\Http\Controllers\Controller;
use App\Services\PostGISService;
use Illuminate\Http\Request;
use Illuminate\Http\JsonResponse;

/**
 * @OA\Tag(
 *     name="Spatial",
 *     description="PostGIS spatial operations for beaches - proximity search, distance calculations, and geographic analysis"
 * )
 */
class PostGISController extends Controller
{
    protected PostGISService $postGISService;

    public function __construct(PostGISService $postGISService)
    {
        $this->postGISService = $postGISService;
    }

    /**
     * @OA\Get(
     *     path="/api/v1/spatial/beaches/within-radius",
     *     summary="Find beaches within radius",
     *     description="Find all beaches within a specified radius from a given point using PostGIS spatial functions",
     *     tags={"Spatial"},
     *     @OA\Parameter(
     *         name="latitude",
     *         in="query",
     *         required=true,
     *         description="Latitude of the center point",
     *         @OA\Schema(type="number", format="float", minimum=-90, maximum=90, example=-22.9711)
     *     ),
     *     @OA\Parameter(
     *         name="longitude",
     *         in="query",
     *         required=true,
     *         description="Longitude of the center point",
     *         @OA\Schema(type="number", format="float", minimum=-180, maximum=180, example=-43.1822)
     *     ),
     *     @OA\Parameter(
     *         name="radius",
     *         in="query",
     *         required=true,
     *         description="Search radius in kilometers",
     *         @OA\Schema(type="number", format="float", minimum=0.1, maximum=20000, example=1000)
     *     ),
     *     @OA\Parameter(
     *         name="limit",
     *         in="query",
     *         required=false,
     *         description="Maximum number of results to return",
     *         @OA\Schema(type="integer", minimum=1, maximum=100, default=50, example=10)
     *     ),
     *     @OA\Response(
     *         response=200,
     *         description="Beaches found within radius",
     *         @OA\JsonContent(ref="#/components/schemas/SpatialBeachesResponse")
     *     ),
     *     @OA\Response(
     *         response=422,
     *         description="Validation error",
     *         @OA\JsonContent(ref="#/components/schemas/ValidationError")
     *     )
     * )
    public function beachesWithinRadius(Request $request): JsonResponse
    {
        $request->validate([
            'latitude' => 'required|numeric|between:-90,90',
            'longitude' => 'required|numeric|between:-180,180',
            'radius' => 'required|numeric|min:0.1|max:20000',
            'limit' => 'sometimes|integer|min:1|max:100'
        ]);

        $beaches = $this->postGISService->findBeachesWithinRadius(
            $request->latitude,
            $request->longitude,
            $request->radius,
            $request->get('limit', 50)
        );

        return response()->json([
            'data' => $beaches,
            'meta' => [
                'center' => [
                    'latitude' => $request->latitude,
                    'longitude' => $request->longitude
                ],
                'radius_km' => $request->radius,
                'count' => $beaches->count()
            ]
        ]);
    }

    /**
     * @OA\Get(
     *     path="/api/v1/spatial/beaches/nearest",
     *     summary="Find nearest beaches",
     *     description="Find the nearest beaches to a given point, ordered by distance",
     *     tags={"Spatial"},
     *     @OA\Parameter(
     *         name="latitude",
     *         in="query",
     *         required=true,
     *         description="Latitude of the reference point",
     *         @OA\Schema(type="number", format="float", minimum=-90, maximum=90, example=36.3932)
     *     ),
     *     @OA\Parameter(
     *         name="longitude",
     *         in="query",
     *         required=true,
     *         description="Longitude of the reference point",
     *         @OA\Schema(type="number", format="float", minimum=-180, maximum=180, example=25.4615)
     *     ),
     *     @OA\Parameter(
     *         name="limit",
     *         in="query",
     *         required=false,
     *         description="Maximum number of nearest beaches to return",
     *         @OA\Schema(type="integer", minimum=1, maximum=50, default=10, example=3)
     *     ),
     *     @OA\Response(
     *         response=200,
     *         description="Nearest beaches found",
     *         @OA\JsonContent(ref="#/components/schemas/SpatialBeachesResponse")
     *     ),
     *     @OA\Response(
     *         response=422,
     *         description="Validation error",
     *         @OA\JsonContent(ref="#/components/schemas/ValidationError")
     *     )
     * )
    public function nearestBeaches(Request $request): JsonResponse
    {
        $request->validate([
            'latitude' => 'required|numeric|between:-90,90',
            'longitude' => 'required|numeric|between:-180,180',
            'limit' => 'sometimes|integer|min:1|max:50'
        ]);

        $beaches = $this->postGISService->findNearestBeaches(
            $request->latitude,
            $request->longitude,
            $request->get('limit', 10)
        );

        return response()->json([
            'data' => $beaches,
            'meta' => [
                'center' => [
                    'latitude' => $request->latitude,
                    'longitude' => $request->longitude
                ],
                'count' => $beaches->count()
            ]
        ]);
    }

    /**
     * @OA\Get(
     *     path="/api/v1/spatial/distance/calculate",
     *     summary="Calculate distance between two points",
     *     description="Calculate the geodesic distance between two geographic points using PostGIS",
     *     tags={"Spatial"},
     *     @OA\Parameter(
     *         name="lat1",
     *         in="query",
     *         required=true,
     *         description="Latitude of the first point",
     *         @OA\Schema(type="number", format="float", minimum=-90, maximum=90, example=-22.9711)
     *     ),
     *     @OA\Parameter(
     *         name="lon1",
     *         in="query",
     *         required=true,
     *         description="Longitude of the first point",
     *         @OA\Schema(type="number", format="float", minimum=-180, maximum=180, example=-43.1822)
     *     ),
     *     @OA\Parameter(
     *         name="lat2",
     *         in="query",
     *         required=true,
     *         description="Latitude of the second point",
     *         @OA\Schema(type="number", format="float", minimum=-90, maximum=90, example=36.3932)
     *     ),
     *     @OA\Parameter(
     *         name="lon2",
     *         in="query",
     *         required=true,
     *         description="Longitude of the second point",
     *         @OA\Schema(type="number", format="float", minimum=-180, maximum=180, example=25.4615)
     *     ),
     *     @OA\Response(
     *         response=200,
     *         description="Distance calculation result",
     *         @OA\JsonContent(ref="#/components/schemas/DistanceCalculationResponse")
     *     ),
     *     @OA\Response(
     *         response=422,
     *         description="Validation error",
     *         @OA\JsonContent(ref="#/components/schemas/ValidationError")
     *     )
     * )
    public function calculateDistance(Request $request): JsonResponse
    {
        $request->validate([
            'lat1' => 'required|numeric|between:-90,90',
            'lon1' => 'required|numeric|between:-180,180',
            'lat2' => 'required|numeric|between:-90,90',
            'lon2' => 'required|numeric|between:-180,180'
        ]);

        $distance = $this->postGISService->calculateDistance(
            $request->lat1,
            $request->lon1,
            $request->lat2,
            $request->lon2
        );

        return response()->json([
            'data' => [
                'distance_km' => round($distance, 2),
                'distance_miles' => round($distance * 0.621371, 2)
            ],
            'meta' => [
                'point1' => ['latitude' => $request->lat1, 'longitude' => $request->lon1],
                'point2' => ['latitude' => $request->lat2, 'longitude' => $request->lon2]
            ]
        ]);
    }

    /**
     * @OA\Get(
     *     path="/api/v1/spatial/beaches/bounding-box",
     *     summary="Get beaches within bounding box",
     *     description="Find all beaches within a rectangular geographic area defined by minimum and maximum coordinates",
     *     tags={"Spatial"},
     *     @OA\Parameter(
     *         name="min_lat",
     *         in="query",
     *         required=true,
     *         description="Minimum latitude of the bounding box",
     *         @OA\Schema(type="number", format="float", minimum=-90, maximum=90, example=35)
     *     ),
     *     @OA\Parameter(
     *         name="min_lon",
     *         in="query",
     *         required=true,
     *         description="Minimum longitude of the bounding box",
     *         @OA\Schema(type="number", format="float", minimum=-180, maximum=180, example=10)
     *     ),
     *     @OA\Parameter(
     *         name="max_lat",
     *         in="query",
     *         required=true,
     *         description="Maximum latitude of the bounding box",
     *         @OA\Schema(type="number", format="float", minimum=-90, maximum=90, example=50)
     *     ),
     *     @OA\Parameter(
     *         name="max_lon",
     *         in="query",
     *         required=true,
     *         description="Maximum longitude of the bounding box",
     *         @OA\Schema(type="number", format="float", minimum=-180, maximum=180, example=30)
     *     ),
     *     @OA\Response(
     *         response=200,
     *         description="Beaches found within bounding box",
     *         @OA\JsonContent(ref="#/components/schemas/BoundingBoxBeachesResponse")
     *     ),
     *     @OA\Response(
     *         response=422,
     *         description="Validation error",
     *         @OA\JsonContent(ref="#/components/schemas/ValidationError")
     *     )
     * )
    public function beachesInBoundingBox(Request $request): JsonResponse
    {
        $request->validate([
            'min_lat' => 'required|numeric|between:-90,90',
            'min_lon' => 'required|numeric|between:-180,180',
            'max_lat' => 'required|numeric|between:-90,90',
            'max_lon' => 'required|numeric|between:-180,180'
        ]);

        $beaches = $this->postGISService->getBeachesInBoundingBox(
            $request->min_lat,
            $request->min_lon,
            $request->max_lat,
            $request->max_lon
        );

        return response()->json([
            'data' => $beaches,
            'meta' => [
                'bounding_box' => [
                    'min_latitude' => $request->min_lat,
                    'min_longitude' => $request->min_lon,
                    'max_latitude' => $request->max_lat,
                    'max_longitude' => $request->max_lon
                ],
                'count' => $beaches->count()
            ]
        ]);
    }

    /**
     * @OA\Get(
     *     path="/api/v1/spatial/beaches/density-grid",
     *     summary="Get beach density grid",
     *     description="Generate a density grid of beaches for heatmap visualization. Returns beach counts per grid cell.",
     *     tags={"Spatial"},
     *     @OA\Parameter(
     *         name="grid_size",
     *         in="query",
     *         required=false,
     *         description="Grid cell size in degrees (approximately 111km per degree)",
     *         @OA\Schema(type="number", format="float", minimum=0.1, maximum=10, default=1.0, example=1.0)
     *     ),
     *     @OA\Response(
     *         response=200,
     *         description="Beach density grid data",
     *         @OA\JsonContent(
     *             @OA\Property(
     *                 property="data",
     *                 type="array",
     *                 description="Array of grid cells with beach counts",
     *                 @OA\Items(
     *                     @OA\Property(property="grid_lat", type="number", format="float", example=46),
     *                     @OA\Property(property="grid_lon", type="number", format="float", example=14),
     *                     @OA\Property(property="beach_count", type="integer", example=1)
     *                 )
     *             ),
     *             @OA\Property(
     *                 property="meta",
     *                 type="object",
     *                 @OA\Property(property="grid_size_degrees", type="number", format="float", example=1.0),
     *                 @OA\Property(property="grid_size_km_approx", type="number", format="float", example=111.0),
     *                 @OA\Property(property="count", type="integer", example=8)
     *             )
     *         )
     *     ),
     *     @OA\Response(
     *         response=422,
     *         description="Validation error",
     *         @OA\JsonContent(ref="#/components/schemas/ValidationError")
     *     )
     * )
    public function beachDensityGrid(Request $request): JsonResponse
    {
        $request->validate([
            'grid_size' => 'sometimes|numeric|min:0.1|max:10'
        ]);

        $density = $this->postGISService->getBeachDensityGrid(
            $request->get('grid_size', 1.0)
        );

        return response()->json([
            'data' => $density,
            'meta' => [
                'grid_size_degrees' => $request->get('grid_size', 1.0),
                'grid_size_km_approx' => round($request->get('grid_size', 1.0) * 111, 1),
                'count' => $density->count()
            ]
        ]);
    }

    /**
     * @OA\Get(
     *     path="/api/v1/spatial/beaches/statistics",
     *     summary="Get beach statistics",
     *     description="Get comprehensive geographic statistics about beach distribution including totals, geographic center, and bounding box",
     *     tags={"Spatial"},
     *     @OA\Response(
     *         response=200,
     *         description="Beach statistics",
     *         @OA\JsonContent(ref="#/components/schemas/BeachStatisticsResponse")
     *     )
     * )
    public function beachStatistics(): JsonResponse
    {
        $stats = $this->postGISService->getBeachStatistics();

        return response()->json([
            'data' => $stats
        ]);
    }
}
